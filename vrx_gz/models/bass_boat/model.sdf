<?xml version="1.0"?>
<!--
  bass_boat - passive FLOATING detection target (no propulsion / no control).
  Purpose: a boat-shaped object my_boat's lidar + camera can record for training
  an AI detection model. Sibling of freedom_365 / brazilian.

  Geometry: the downloaded STL is in METRES. Long axis is +Y (~8.15 m), beam +X
  (~2.90 m), height +Z (~2.11 m), keel at z = -0.948, top at z = 1.162.

  Floating recipe (same as freedom_365):
    keel (= buoyancy box bottom) at base_link z = -0.948
    target draft d = 0.55 m  ->  buoyancy box height 2*d = 1.10 m
    footprint A = 2.5 x 6.9 = 17.25 m^2
    mass m = rho * A * d = 1000 * 17.25 * 0.55 ~= 9490 kg  (floats mid-box)
    world pose z = -d - keel = -0.55 - (-0.948) = +0.398

  VISUAL  = the full STL mesh - this is what the gpu_lidar and the camera see.
  PHYSICS = a cheap BOX collision + vrx::PolyhedraBuoyancyDrag tuned to float
            at ~0.55 m draft.
-->
<sdf version="1.9">
  <model name="bass_boat">
    <link name="base_link">
      <inertial>
        <!-- Box approximation (2.895 x 8.152 x 1.3 m effective), ~9.49 t. -->
        <mass>9490.0</mass>
        <inertia>
          <ixx>53896</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>7965</iyy><iyz>0</iyz>
          <izz>59185</izz>
        </inertia>
      </inertial>

      <!-- VISUAL: the downloaded mesh = what the lidar + camera record. -->
      <visual name="hull_visual">
        <geometry>
          <mesh>
            <uri>model://bass_boat/meshes/bass_boat.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.78 0.80 0.85 1</ambient>
          <diffuse>0.72 0.75 0.82 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>

      <!-- COLLISION: simple box spanning the hull near the waterline. -->
      <collision name="hull_collision">
        <pose>0 0 -0.398 0 0 0</pose>
        <geometry>
          <box><size>2.7 7.2 1.2</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Buoyancy + hydrodynamic drag (identical plugin to the world's buoys).
         The <buoyancy> box (not the collision) generates lift; sized so ~9.49 t
         floats at ~0.55 m draft. Raise/lower <mass> to change the draft; raise
         the drag values to keep it more planted against wave drift. -->
    <plugin name="vrx::PolyhedraBuoyancyDrag" filename="libPolyhedraBuoyancyDrag.so">
      <fluid_density>1000</fluid_density>
      <fluid_level>0.0</fluid_level>
      <linear_drag>1600.0</linear_drag>
      <angular_drag>4000.0</angular_drag>
      <buoyancy name="hull">
        <link_name>base_link</link_name>
        <pose>0 0 -0.398 0 0 0</pose>
        <geometry>
          <box><size>2.5 6.9 1.1</size></box>
        </geometry>
      </buoyancy>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>
  </model>
</sdf>
