<?xml version="1.0"?>
<model>
  <name>Floating Log</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>log_description package</name>
    <email>user@todo.todo</email>
  </author>

  <description>
    A simple floating cylindrical log (2.0 m length, 0.15 m radius, 50 kg)
    intended for use in the VRX / Gazebo Garden environment.
    The model is designed to interact correctly with buoyancy, wave,
    wind, and collision physics. Cylinder axis is aligned with the X-axis
    of the body frame (bow-to-stern convention).
  </description>
</model>
