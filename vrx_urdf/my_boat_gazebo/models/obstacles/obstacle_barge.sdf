<?xml version="1.0"?>
<!-- Barge / pontoon. 8 x 3 m footprint, 2.25 m proud of the water.
     STATIC on purpose: on water a non-static body with no buoyancy plugin
     simply sinks. <static>true</static> also means the GUI Translate tool
     places it exactly where you drop it and it stays there.
     Geometry is sized so it protrudes 2-3.5 m above the waterline (z=0):
     the STVL costmap layer ignores returns below min_obstacle_height 0.3
     and above max_obstacle_height 8.0. -->
<sdf version="1.9">
  <model name="obstacle_barge">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry><box><size>8.0 3.0 3.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry><box><size>8.0 3.0 3.0</size></box></geometry>
        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.42 0.42 0.45 1</diffuse>
          <specular>0.35 0.35 0.37 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
