<?xml version="1.0"?>
<!--
  model.sdf - standalone SDF mirror of the pure body in
  urdf/my_boat_base.urdf.xacro. Lets `gz sim` insert the bare hull directly
  (no plugins). The xacro is authoritative; keep the two in sync.
  Transform (CG-centred, STL in mm): pose xyz = -R*(scale*CG), rpy = pi/2 0 pi/2,
  mesh scale 0.001. See docs/FRAME_AND_CG.md.
-->
<sdf version="1.9">
  <model name="my_boat">
    <static>false</static>

    <link name="base_link">
      <!-- base_link IS the centre of gravity (hull volume centroid). -->
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>420.0</mass>
        <inertia>
          <ixx>100.22</ixx>
          <ixy>0.0</ixy>
          <ixz>-5.48</ixz>
          <iyy>606.43</iyy>
          <iyz>0.0</iyz>
          <izz>652.79</izz>
        </inertia>
      </inertial>

      <visual name="hull_visual">
        <pose>-2.3145 -0.9245 -0.4916 1.5707963 0 1.5707963</pose>
        <geometry>
          <mesh>
            <uri>model://my_boat/mesh/my_boat_hull.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.06 0.06 0.07 1</ambient>
          <diffuse>0.08 0.08 0.09 1</diffuse>
          <specular>0.35 0.35 0.37 1</specular>
        </material>
      </visual>

      <collision name="hull_collision">
        <pose>-0.23 0 -0.025 0 0 0</pose>
        <geometry>
          <box><size>4.0 1.7 0.85</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
          </friction>
          <contact>
            <ode><kp>1e6</kp><kd>1.0</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
