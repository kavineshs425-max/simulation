<?xml version="1.0"?>
<model>
  <name>my_boat</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>my_boat_description package</name>
    <email>kavineshs@wroxai.com</email>
  </author>

  <description>
    Resource entry for the custom boat hull mesh. Allows Gazebo to resolve
    model:// and package:// URIs pointing at models/my_boat/mesh. The
    authoritative model is generated from urdf/my_boat_base.urdf.xacro;
    model.sdf is a standalone convenience mirror of the pure body.
  </description>
</model>
