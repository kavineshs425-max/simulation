# =============================================================================
# obstacles.yaml -- THE config file for my_boat_obstacles
# =============================================================================
# Loaded by default:   ros2 launch my_boat_obstacles moving_obstacles.launch.py
# Another file:        ... moving_obstacles.launch.py config:=/path/to/file.yaml
#
# Edit this file while the sim is running, then apply it without restarting:
#   ros2 service call /obstacle_spawner/reload std_srvs/srv/Trigger
# (the workspace is --symlink-install, so the installed copy IS this file).
# A file with a mistake in it is rejected as a whole and nothing changes;
# the reason is in the service reply.
#
# Obstacles spawn at `start` and HOLD STILL until:
#   ros2 service call /obstacle_spawner/run   std_srvs/srv/Trigger
#   ros2 service call /obstacle_spawner/reset std_srvs/srv/Trigger   # back to start
#
# COORDINATES: Gazebo world, ENU.  x = east, y = north  [m]
#              heading_deg: 0 = east, 90 = north, 180 = west, -90 = south
# my_boat spawns at (-528, 186) facing east (heading 0).
# =============================================================================

scenario:
  name: drawing_four_obstacles     # just a label for the log

# -----------------------------------------------------------------------------
# Spawner settings. Every key is optional; these are the defaults.
# -----------------------------------------------------------------------------
settings:
  world: sydney_regatta      # running Gazebo world         (reload: needs restart)
  boat_model: my_boat        # our boat's Gazebo model name (reload: needs restart)
  name_prefix: obs           # Gazebo model = <prefix>_<name> (reload: needs restart)
  world_frame: world         # frame_id on /sim/obstacles/* ground truth
  run_lead_s: 0.5            # [s] motion starts this long after the run call
  sample_step_s: 0.5         # [s] path sampling for the plugin (corner cut <= speed*step/2)
  duration_s: 600.0          # [s] paths play this long after run, then hold still
  model_paths: []            # extra folders of your own 3-D models (models/ is always searched)
  # my_boat's collision box, used to REPORT hits on /sim/obstacles/collisions
  # (Gazebo does the physics itself). From my_boat_base.urdf.xacro.
  boat_box_length: 4.0
  boat_box_width: 1.7
  boat_box_offset_x: 0.23    # box centre ahead of the model origin
  land_mask: ''              # warns if an obstacle starts on land or runs ashore:
                             # '' = worlds/<world>_land.npz (shipped for sydney_regatta),
                             # 'none' = off, or a path. Build one: tools/make_land_mask.py
  collision_release_s: 1.0   # [s] a hit ends only after this long with no contact
                             #   (the boat bounces along a hull while being shoved)
  speed_scale: 1.0           # multiplies EVERY obstacle's speed (2.0 = all twice as fast,
                             # same paths). Live too, no restart:
                             #   ros2 param set /obstacle_spawner speed_scale 2.0
  on_contact: stop           # what an obstacle does when it touches another obstacle
                             # or my_boat: stop (halts there) | pass (keeps its path).
                             # Obstacles are scripted, so without "stop" two of them
                             # drive straight through each other.

# -----------------------------------------------------------------------------
# Obstacles. Per obstacle:
#
#   name          unique; also the service name for set_start
#   model         what it looks like / what the lidar sees:
#                   brazilian   5.1 m boat (mesh)     default class boat
#                   bass_boat   8.2 m boat (mesh)     default class boat
#                   freedom_365 10.2 m yacht (mesh)   default class ship
#                   kayak       4.0 x 0.8 box         default class kayak
#                   buoy        0.8 m cylinder        default class buoy
#                   swimmer     0.6 x 0.5 box         default class swimmer
#                   barge       8 x 3 box             default class barge
#                   pillar      1.0 m cylinder        default class pillar
#                   obstacle_buoy / obstacle_pillar / obstacle_barge
#                               the first static field's shapes (yellow buoy
#                               0.9 x 2.4 m, orange pillar 1.2 x 5 m, grey barge)
#                 ...plus YOUR OWN models: every folder in models/ with a
#                 model.yaml (see models/README.md). Shipped examples:
#                   shipping_container  textured .obj     default class debris
#                   channel_marker      coloured .stl     default class marker
#   class         optional detector label (Gazebo Label system):
#                   unknown boat ship kayak buoy swimmer barge pillar
#                   marker debris structure
#   vessel_class  optional COLREGs truth: unknown power_driven sailing fishing
#                   restricted_manoeuvre not_under_command
#   size          optional [length, width, height] m -- PRIMITIVES ONLY
#                   (kayak buoy swimmer barge pillar); buoy/pillar need l == w.
#                   A mesh is sized by `scale` in its model.yaml.
#   colour        optional [r, g, b] 0..1 -- ANY model. On a mesh that has its
#                   own materials (.glb, .obj+.mtl, .dae) it replaces them.
#   texture       optional image (png/jpg), path relative to THIS file.
#                   Primitives, and meshes with texture coordinates (.obj
#                   .glb .gltf .dae). Not the built-in boats or any .stl: an STL
#                   has no texture coordinates (you get an error saying so).
#                   With colour too, the colour tints the image.
#   collision     optional: box (default) -- a box round the hull, fast
#                           mesh          -- the exact mesh shape (meshes only; slower)
#                           none          -- sensors see it, the boat passes through
#                 Every hit is logged and published on /sim/obstacles/collisions.
#
#   start         {x, y, heading_deg}  where it waits, and which way it points
#   speed         HOW FAST it moves after run, m/s (1 m/s = 1.94 kn).
#                   Or speed_kn: in knots. Needed by every moving obstacle.
#   motion        HOW it moves after run (leave out = static):
#                   {type: static}
#                   {type: constant_velocity}                     straight along heading_deg
#                   {type: constant_turn, turn_rate_deg_s: 3.0}   + = to port (CCW)
#                   {type: waypoints, loop: true, points: [[x, y], ...]}
#                 (speed may also be written inside motion: {type: ..., speed: 1.0})
#   start_delay   optional [s] wait after run before moving (default 0)
#   crab_deg      optional: the bow points this far off the direction of travel
#                   (heading = course + crab); tests heading-vs-course handling
#   on_contact    optional: stop | pass -- overrides settings.on_contact
# -----------------------------------------------------------------------------

obstacles:
  - name: centre_crosser
    model: brazilian
    class: boat
    vessel_class: power_driven
    colour: [0.85, 0.1, 0.1]
    start: {x: -429.4, y: 218.24}
